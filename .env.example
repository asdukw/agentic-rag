HYBRID_RAG_DATABASE_URL=sqlite:///storage/app.db
HYBRID_RAG_CHUNK_SIZE_TOKENS=512
HYBRID_RAG_CHUNK_OVERLAP_TOKENS=64
HYBRID_RAG_TOKENIZER_NAME=cl100k_base
HYBRID_RAG_LOG_LEVEL=INFO

# Optional DeepSeek settings for extraction, query expansion, answer generation, and Ragas judging.
# Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_QUERY_MODEL=deepseek-v4-flash
DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGE_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_ANSWER_MAX_OUTPUT_TOKENS=2048
DEEPSEEK_JUDGE_MAX_OUTPUT_TOKENS=1024
DEEPSEEK_TIMEOUT_SECONDS=180
# Local CNY price assumptions per million tokens. The cost reports use the
# actual response model plus prompt_cache_hit_tokens,
# prompt_cache_miss_tokens, and completion_tokens; they are estimates, not a
# provider bill. Keep all six values current for the models you use.
DEEPSEEK_FLASH_INPUT_CACHE_HIT_CNY_PER_MILLION_TOKENS=0.02
DEEPSEEK_FLASH_INPUT_CACHE_MISS_CNY_PER_MILLION_TOKENS=1.00
DEEPSEEK_FLASH_OUTPUT_CNY_PER_MILLION_TOKENS=2.00
DEEPSEEK_PRO_INPUT_CACHE_HIT_CNY_PER_MILLION_TOKENS=0.025
DEEPSEEK_PRO_INPUT_CACHE_MISS_CNY_PER_MILLION_TOKENS=3.00
DEEPSEEK_PRO_OUTPUT_CNY_PER_MILLION_TOKENS=6.00

HYBRID_RAG_GRAPH_CHECKPOINT_PATH=storage/langgraph.db
HYBRID_RAG_GRAPH_MAX_CONCURRENCY=8
HYBRID_RAG_GRAPH_MAX_ATTEMPTS=2
HYBRID_RAG_GRAPH_TOP_K=10
LANGGRAPH_STRICT_MSGPACK=true

# The default is local BGE-M3 through FlagEmbedding. The first index build downloads
# model weights, but no embedding API key is required. Keep fp16=false on CPU.
HYBRID_RAG_RETRIEVAL_EMBEDDING_PROVIDER=flagembedding
HYBRID_RAG_RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-m3
HYBRID_RAG_RETRIEVAL_EMBEDDING_DIMENSIONS=1024
HYBRID_RAG_RETRIEVAL_EMBEDDING_BATCH_SIZE=12
HYBRID_RAG_RETRIEVAL_EMBEDDING_MAX_LENGTH=8192
HYBRID_RAG_RETRIEVAL_EMBEDDING_USE_FP16=false
HYBRID_RAG_RETRIEVAL_TOP_K=8
HYBRID_RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
HYBRID_RAG_RETRIEVAL_CONTEXT_TOKEN_BUDGET=2400
HYBRID_RAG_RETRIEVAL_GRAPH_MAX_HOPS=2
# These route weights apply to `mix` (naive + local + global). `hybrid` uses
# only the local and global weights. Each route is normalized independently;
# candidates are ranked by the summed weighted score before optional reranking
# and coverage-first token-budget selection.
HYBRID_RAG_RETRIEVAL_NAIVE_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_LOCAL_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_GLOBAL_WEIGHT=1.0
# This project's naive route combines dense chunk recall with deterministic local
# BM25. This is an extension beyond LightRAG's vector-only naive mode.
HYBRID_RAG_RETRIEVAL_NAIVE_DENSE_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_NAIVE_BM25_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_BM25_K1=1.2
HYBRID_RAG_RETRIEVAL_BM25_B=0.75
# Keep first-stage retrieval order by default. Set the provider to
# `flagembedding` to run a second-stage cross-encoder after route fusion and
# before final Top-K/context selection. FlagEmbedding is installed by `uv sync`.
HYBRID_RAG_RETRIEVAL_RERANKER_PROVIDER=none
HYBRID_RAG_RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
HYBRID_RAG_RETRIEVAL_RERANKER_USE_FP16=false
HYBRID_RAG_RETRIEVAL_RERANK_CANDIDATE_MULTIPLIER=4
# The cross-encoder also runs on CPU with fp16=false; change the preceding
# value to true only on a CUDA-capable GPU.

# `hybrid-rag evaluate --testset ...` requires DEEPSEEK_API_KEY. Its retrieval
# options come from the values above unless overridden by CLI flags; the default
# evaluation mode is `mix`.
HYBRID_RAG_EVALUATION_OUTPUT_DIR=artifacts/evaluations
