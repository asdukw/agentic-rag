HYBRID_RAG_DATABASE_URL=sqlite:///storage/app.db
HYBRID_RAG_CHUNK_SIZE_TOKENS=512
HYBRID_RAG_CHUNK_OVERLAP_TOKENS=64
HYBRID_RAG_TOKENIZER_NAME=cl100k_base
HYBRID_RAG_LOG_LEVEL=INFO

# Optional DeepSeek settings for extraction, query expansion, answer generation, and judging.
# Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_QUERY_MODEL=deepseek-v4-flash
DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGE_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_ANSWER_MAX_OUTPUT_TOKENS=2048
DEEPSEEK_JUDGE_MAX_OUTPUT_TOKENS=1024
DEEPSEEK_TIMEOUT_SECONDS=180

HYBRID_RAG_GRAPH_CHECKPOINT_PATH=storage/langgraph.db
HYBRID_RAG_GRAPH_MAX_CONCURRENCY=8
HYBRID_RAG_GRAPH_MAX_ATTEMPTS=3
HYBRID_RAG_GRAPH_TOP_K=10
LANGGRAPH_STRICT_MSGPACK=true

# The deterministic local hash embedding is the default, so indexing, retrieval,
# tests, and demos need neither a model download nor a separate embedding API.
HYBRID_RAG_RETRIEVAL_EMBEDDING_PROVIDER=hash
HYBRID_RAG_RETRIEVAL_EMBEDDING_MODEL=hash-token-v1
HYBRID_RAG_RETRIEVAL_EMBEDDING_DIMENSIONS=384
# Required only when EMBEDDING_PROVIDER=openai-compatible.
HYBRID_RAG_RETRIEVAL_EMBEDDING_BASE_URL=
HYBRID_RAG_RETRIEVAL_EMBEDDING_API_KEY=
HYBRID_RAG_RETRIEVAL_EMBEDDING_BATCH_SIZE=64
HYBRID_RAG_RETRIEVAL_TOP_K=8
HYBRID_RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=4
HYBRID_RAG_RETRIEVAL_CONTEXT_TOKEN_BUDGET=2400
HYBRID_RAG_RETRIEVAL_GRAPH_MAX_HOPS=2
HYBRID_RAG_RETRIEVAL_NAIVE_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_LOCAL_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_GLOBAL_WEIGHT=1.0
# Naive combines dense chunk recall with deterministic lexical BM25.  Both
# subroute weights are normalized before fusion; BM25 runs locally over chunk text.
HYBRID_RAG_RETRIEVAL_NAIVE_DENSE_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_NAIVE_BM25_WEIGHT=1.0
HYBRID_RAG_RETRIEVAL_BM25_K1=1.2
HYBRID_RAG_RETRIEVAL_BM25_B=0.75
# A second-stage reranker runs after route fusion and before final Top-K/context
# selection. `lexical` is the deterministic local baseline; `none` keeps
# first-stage order. `flagembedding` is a local cross-encoder and requires
# `uv sync --extra reranker` plus a FlagEmbedding model ID.
HYBRID_RAG_RETRIEVAL_RERANKER_PROVIDER=lexical
HYBRID_RAG_RETRIEVAL_RERANKER_MODEL=lexical-coverage-v1
HYBRID_RAG_RETRIEVAL_RERANKER_USE_FP16=false
HYBRID_RAG_RETRIEVAL_RERANK_CANDIDATE_MULTIPLIER=4
# Example real cross-encoder configuration (enable on a CUDA-capable setup only):
# HYBRID_RAG_RETRIEVAL_RERANKER_PROVIDER=flagembedding
# HYBRID_RAG_RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# HYBRID_RAG_RETRIEVAL_RERANKER_USE_FP16=true

# Evaluation and report defaults. Judge use is opt-in via `evaluate --deepseek-judge`.
HYBRID_RAG_EVALUATION_BENCHMARK_PATH=data/evaluation/fixture-benchmark-v1.json
HYBRID_RAG_EVALUATION_OUTPUT_DIR=artifacts/evaluations
HYBRID_RAG_EVALUATION_TOP_K=5
HYBRID_RAG_EVALUATION_CONTEXT_TOKEN_BUDGET=2400
HYBRID_RAG_EVALUATION_GRAPH_MAX_HOPS=2
# These prices apply only to the opt-in DeepSeek blind judge.  The CLI never
# fabricates a cost for an external embedding provider; it reports `unknown`
# until a complete verified usage/price disclosure is supplied programmatically.
# Leave judge pricing unset unless it has been verified for the selected model.
# HYBRID_RAG_EVALUATION_INPUT_COST_USD_PER_MILLION_TOKENS=0.00
# HYBRID_RAG_EVALUATION_OUTPUT_COST_USD_PER_MILLION_TOKENS=0.00
